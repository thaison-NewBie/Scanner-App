# First test on Ubuntu itself; replace with its LAN IPv4 for phone access later.
SCANNER_BIND_ADDRESS=127.0.0.1
SCANNER_PORT=18080

# Use the values printed by id -u and id -g on Ubuntu.
SCANNER_UID=1000
SCANNER_GID=1000

# Paths are on the Ubuntu host, relative to docker-compose.yml or absolute.
SCANNER_IMAGES_DIR=./docker-data/images
SCANNER_REPORTS_DIR=./docker-data/reports
